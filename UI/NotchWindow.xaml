<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsNotch.UI.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Notch">

    <!-- Notch Root: transparent outer canvas hosting shadow, surface, border, and content layers -->
    <Grid
        x:Name="NotchRoot"
        Background="Transparent">

        <!-- 1. Shadow / Depth Layer (Compositor DropShadow behind the pill surface) -->
        <Grid
            x:Name="ShadowLayer"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />

        <!-- 2. Clipped Pill Surface Container -->
        <Grid
            x:Name="NotchSurface"
            Width="{StaticResource NotchCollapsedWidth}"
            Height="{StaticResource NotchCollapsedHeight}"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            PointerEntered="OnNotchPointerEntered"
            PointerMoved="OnNotchPointerMoved"
            PointerExited="OnNotchPointerExited">

            <!-- 2a. Optional Native Composition Glass Backdrop Layer -->
            <Grid
                x:Name="BackdropGlassLayer"
                IsHitTestVisible="False" />

            <!-- 2b. Dark Surface Base (Translucent when glass is active; solid dark fallback otherwise) -->
            <Border
                x:Name="SurfaceBaseLayer"
                Background="{StaticResource NotchSurfaceGlassBrush}"
                IsHitTestVisible="False" />

            <!-- 2c. Subtle Inner Depth Sheen -->
            <Border
                x:Name="SurfaceDepthLayer"
                Background="{StaticResource NotchInnerDepthBrush}"
                IsHitTestVisible="False" />

            <!-- 3. Border / Highlight Layer (1px Compositor Rounded Pill Stroke) -->
            <Grid
                x:Name="BorderHighlightLayer"
                IsHitTestVisible="False" />

            <!-- 4. Content Layer (Clock View + Media Hover/Expanded View + Clipboard Hover View + Screenshot Hover View + DropTarget View + Calendar Hover View) -->
            <Grid
                x:Name="ContentHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- 4a. Clock View (Idle / Collapsed Media, Clipboard, Screenshot, Drop, or Calendar Indicator + Time) -->
                <StackPanel
                    x:Name="ClockViewHost"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Spacing8}"
                    IsHitTestVisible="False">

                    <TextBlock
                        x:Name="CollapsedMediaIndicator"
                        Text="&#x266A;"
                        FontFamily="{StaticResource NotchFontFamily}"
                        FontSize="{StaticResource FontSizeCaption}"
                        FontWeight="Medium"
                        Foreground="{StaticResource NotchAccentBrush}"
                        VerticalAlignment="Center"
                        TextLineBounds="Tight"
                        OpticalMarginAlignment="TrimSideBearings"
                        Visibility="Collapsed" />

                    <Path
                        x:Name="CollapsedClipboardIndicator"
                        Width="{StaticResource ClipboardCollapsedIconSize}"
                        Height="{StaticResource ClipboardCollapsedIconSize}"
                        Stretch="Uniform"
                        Fill="{StaticResource NotchSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Data="M 3.5,1 L 6.5,1 L 6.5,2.2 L 8.2,2.2 L 8.2,9.2 L 1.8,9.2 L 1.8,2.2 L 3.5,2.2 Z M 3,3.4 L 3,8 L 7,8 L 7,3.4 Z" />

                    <Path
                        x:Name="CollapsedScreenshotIndicator"
                        Width="{StaticResource ScreenshotCollapsedIconSize}"
                        Height="{StaticResource ScreenshotCollapsedIconSize}"
                        Stretch="Uniform"
                        Fill="{StaticResource NotchSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Data="F0 M 3.4,1.5 L 4.1,0.7 L 5.9,0.7 L 6.6,1.5 L 8.5,1.5 C 9.05,1.5 9.5,1.95 9.5,2.5 L 9.5,7.5 C 9.5,8.05 9.05,8.5 8.5,8.5 L 1.5,8.5 C 0.95,8.5 0.5,8.05 0.5,7.5 L 0.5,2.5 C 0.5,1.95 0.95,1.5 1.5,1.5 Z M 5,3.1 C 3.84,3.1 2.9,4.04 2.9,5.2 C 2.9,6.36 3.84,7.3 5,7.3 C 6.16,7.3 7.1,6.36 7.1,5.2 C 7.1,4.04 6.16,3.1 5,3.1 Z" />

                    <Path
                        x:Name="CollapsedDropIndicator"
                        Width="{StaticResource DropCollapsedIconSize}"
                        Height="{StaticResource DropCollapsedIconSize}"
                        Stretch="Uniform"
                        Fill="{StaticResource NotchSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Data="M 2,1 L 6,1 L 8.5,3.5 L 8.5,9 L 2,9 Z M 5.5,1.8 L 5.5,4 L 7.7,4 Z" />

                    <Path
                        x:Name="CollapsedCalendarIndicator"
                        Width="{StaticResource CalendarCollapsedIconSize}"
                        Height="{StaticResource CalendarCollapsedIconSize}"
                        Stretch="Uniform"
                        Fill="{StaticResource NotchAccentBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Data="M 2.5,0.8 L 3.7,0.8 L 3.7,2 L 6.3,2 L 6.3,0.8 L 7.5,0.8 L 7.5,2 L 8.8,2 L 8.8,9 L 1.2,9 L 1.2,2 L 2.5,2 Z M 2.2,4.2 L 2.2,8 L 7.8,8 L 7.8,4.2 Z" />

                    <Grid
                        x:Name="ClockTextHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="ClockPrimaryText"
                            FontFamily="{StaticResource NotchFontFamily}"
                            FontSize="{StaticResource FontSizeBody}"
                            FontWeight="Medium"
                            Foreground="{StaticResource NotchPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextLineBounds="Tight"
                            OpticalMarginAlignment="TrimSideBearings"
                            Typography.NumeralAlignment="Tabular" />
                        <TextBlock
                            x:Name="ClockSecondaryText"
                            FontFamily="{StaticResource NotchFontFamily}"
                            FontSize="{StaticResource FontSizeBody}"
                            FontWeight="Medium"
                            Foreground="{StaticResource NotchPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextLineBounds="Tight"
                            OpticalMarginAlignment="TrimSideBearings"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <TextBlock
                        x:Name="CollapsedCalendarTimeText"
                        FontFamily="{StaticResource NotchFontFamily}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="Medium"
                        Foreground="{StaticResource NotchPrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="104"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1"
                        TextLineBounds="Tight"
                        OpticalMarginAlignment="TrimSideBearings"
                        Typography.NumeralAlignment="Tabular"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- 4a-action. Subtle Screenshot Capture Action in Clock Hover (220x44) -->
                <Grid
                    x:Name="ClockHoverScreenshotActionHost"
                    Width="{StaticResource NotchHoverWidth}"
                    Height="{StaticResource NotchHoverHeight}"
                    Padding="{StaticResource ClockHoverPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                    <Button
                        x:Name="ClockScreenshotButton"
                        Style="{StaticResource NotchMediaTransportButtonStyle}"
                        AutomationProperties.Name="Capture screenshot"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnScreenshotCaptureButtonClick"
                        PointerEntered="OnTransportButtonPointerEntered"
                        PointerExited="OnTransportButtonPointerExited"
                        PointerCanceled="OnTransportButtonPointerCanceled"
                        PointerCaptureLost="OnTransportButtonPointerCaptureLost">
                        <Grid
                            Width="{StaticResource MediaControlButtonSize}"
                            Height="{StaticResource MediaControlButtonSize}">
                            <Border
                                x:Name="ClockScreenshotButtonBg"
                                CornerRadius="{StaticResource Radius8}"
                                Background="{StaticResource NotchElevatedBrush}" />
                            <Path
                                x:Name="ClockScreenshotButtonIcon"
                                Width="{StaticResource ScreenshotActionIconSize}"
                                Height="{StaticResource ScreenshotActionIconSize}"
                                Stretch="Uniform"
                                Fill="{StaticResource NotchPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="F0 M 3.4,1.5 L 4.1,0.7 L 5.9,0.7 L 6.6,1.5 L 8.5,1.5 C 9.05,1.5 9.5,1.95 9.5,2.5 L 9.5,7.5 C 9.5,8.05 9.05,8.5 8.5,8.5 L 1.5,8.5 C 0.95,8.5 0.5,8.05 0.5,7.5 L 0.5,2.5 C 0.5,1.95 0.95,1.5 1.5,1.5 Z M 5,3.1 C 3.84,3.1 2.9,4.04 2.9,5.2 C 2.9,6.36 3.84,7.3 5,7.3 C 6.16,7.3 7.1,6.36 7.1,5.2 C 7.1,4.04 6.16,3.1 5,3.1 Z" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- 4b. Media Hover (220x44) & Expanded (380x88) View -->
                <Grid
                    x:Name="MediaViewHost"
                    Width="{StaticResource NotchHoverWidth}"
                    Height="{StaticResource NotchHoverHeight}"
                    Padding="{StaticResource MediaHoverPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header ([Artwork + Title/Artist] + [‹ ▶/❚❚ ›]) -->
                    <Grid
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        ColumnSpacing="{StaticResource Spacing8}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Clickable Metadata / Artwork Region (expands panel when clicked in Hover state) -->
                        <Grid
                            x:Name="MediaMetadataClickTarget"
                            Grid.Column="0"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            ColumnSpacing="{StaticResource Spacing8}"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="Expand media timeline"
                            PointerPressed="OnMediaMetadataPointerPressed"
                            PointerReleased="OnMediaMetadataPointerReleased"
                            PointerCanceled="OnMediaMetadataPointerCanceled"
                            PointerCaptureLost="OnMediaMetadataPointerCaptureLost">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Rounded Album Artwork (28x28 in Hover, 40x40 in Expanded) -->
                            <Border
                                x:Name="MediaArtworkHost"
                                Grid.Column="0"
                                Width="{StaticResource MediaHoverArtworkSize}"
                                Height="{StaticResource MediaHoverArtworkSize}"
                                CornerRadius="{StaticResource Radius8}"
                                Background="{StaticResource NotchElevatedBrush}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <Grid>
                                    <TextBlock
                                        x:Name="MediaArtworkFallbackIcon"
                                        Text="&#x266A;"
                                        FontFamily="{StaticResource NotchFontFamily}"
                                        FontSize="{StaticResource FontSizeSecondary}"
                                        Foreground="{StaticResource NotchSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextLineBounds="Tight" />
                                    <Border
                                        x:Name="MediaArtworkImageClip"
                                        CornerRadius="{StaticResource Radius8}"
                                        Visibility="Collapsed">
                                        <Image
                                            x:Name="MediaArtworkImage"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Song Title & Artist Metadata -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource MediaMetadataStackSpacing}"
                                IsHitTestVisible="False">
                                <TextBlock
                                    x:Name="MediaTitleText"
                                    FontFamily="{StaticResource NotchFontFamily}"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource NotchPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1"
                                    TextLineBounds="Tight" />
                                <TextBlock
                                    x:Name="MediaArtistText"
                                    FontFamily="{StaticResource NotchFontFamily}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    FontWeight="Normal"
                                    Foreground="{StaticResource NotchSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1"
                                    TextLineBounds="Tight" />
                            </StackPanel>
                        </Grid>

                        <!-- Subtle Media Playback Controls: Previous, Play/Pause, Next -->
                        <StackPanel
                            x:Name="MediaControlsHost"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource MediaControlButtonSpacing}"
                            IsHitTestVisible="False">

                            <Button
                                x:Name="PreviousTrackButton"
                                Style="{StaticResource NotchMediaTransportButtonStyle}"
                                AutomationProperties.Name="Previous track"
                                IsEnabled="False"
                                Click="OnPreviousTrackButtonClick"
                                PointerEntered="OnTransportButtonPointerEntered"
                                PointerExited="OnTransportButtonPointerExited"
                                PointerCanceled="OnTransportButtonPointerCanceled"
                                PointerCaptureLost="OnTransportButtonPointerCaptureLost">
                                <Grid
                                    Width="{StaticResource MediaControlButtonSize}"
                                    Height="{StaticResource MediaControlButtonSize}">
                                    <Border
                                        x:Name="PreviousButtonBg"
                                        CornerRadius="{StaticResource Radius8}"
                                        Background="{StaticResource NotchElevatedBrush}" />
                                    <Path
                                        x:Name="PreviousButtonIcon"
                                        Width="{StaticResource MediaControlIconSize}"
                                        Height="{StaticResource MediaControlIconSize}"
                                        Stretch="Uniform"
                                        Fill="{StaticResource NotchPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 1.5,1.5 L 3,1.5 L 3,8.5 L 1.5,8.5 Z M 3.5,5 L 8.5,1.5 L 8.5,8.5 Z" />
                                </Grid>
                            </Button>

                            <Button
                                x:Name="PlayPauseButton"
                                Style="{StaticResource NotchMediaTransportButtonStyle}"
                                AutomationProperties.Name="Play"
                                IsEnabled="False"
                                Click="OnPlayPauseButtonClick"
                                PointerEntered="OnTransportButtonPointerEntered"
                                PointerExited="OnTransportButtonPointerExited"
                                PointerCanceled="OnTransportButtonPointerCanceled"
                                PointerCaptureLost="OnTransportButtonPointerCaptureLost">
                                <Grid
                                    Width="{StaticResource MediaControlButtonSize}"
                                    Height="{StaticResource MediaControlButtonSize}">
                                    <Border
                                        x:Name="PlayPauseButtonBg"
                                        CornerRadius="{StaticResource Radius8}"
                                        Background="{StaticResource NotchElevatedBrush}" />
                                    <Grid
                                        x:Name="PlayPauseButtonIconHost"
                                        Width="{StaticResource MediaControlIconSize}"
                                        Height="{StaticResource MediaControlIconSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Path
                                            x:Name="PlayIconPath"
                                            Stretch="Uniform"
                                            Fill="{StaticResource NotchPrimaryBrush}"
                                            Data="M 2.5,1.2 L 9,5 L 2.5,8.8 Z" />
                                        <Path
                                            x:Name="PauseIconPath"
                                            Stretch="Uniform"
                                            Fill="{StaticResource NotchPrimaryBrush}"
                                            Visibility="Collapsed"
                                            Data="M 2,1.5 L 4.2,1.5 L 4.2,8.5 L 2,8.5 Z M 5.8,1.5 L 8,1.5 L 8,8.5 L 5.8,8.5 Z" />
                                    </Grid>
                                </Grid>
                            </Button>

                            <Button
                                x:Name="NextTrackButton"
                                Style="{StaticResource NotchMediaTransportButtonStyle}"
                                AutomationProperties.Name="Next track"
                                IsEnabled="False"
                                Click="OnNextTrackButtonClick"
                                PointerEntered="OnTransportButtonPointerEntered"
                                PointerExited="OnTransportButtonPointerExited"
                                PointerCanceled="OnTransportButtonPointerCanceled"
                                PointerCaptureLost="OnTransportButtonPointerCaptureLost">
                                <Grid
                                    Width="{StaticResource MediaControlButtonSize}"
                                    Height="{StaticResource MediaControlButtonSize}">
                                    <Border
                                        x:Name="NextButtonBg"
                                        CornerRadius="{StaticResource Radius8}"
                                        Background="{StaticResource NotchElevatedBrush}" />
                                    <Path
                                        x:Name="NextButtonIcon"
                                        Width="{StaticResource MediaControlIconSize}"
                                        Height="{StaticResource MediaControlIconSize}"
                                        Stretch="Uniform"
                                        Fill="{StaticResource NotchPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 1.5,1.5 L 6.5,5 L 1.5,8.5 Z M 7,1.5 L 8.5,1.5 L 8.5,8.5 L 7,8.5 Z" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Expanded Media Timeline & Seek Bar (0:42 ━━━━━●━━━━━ 3:28) -->
                    <Grid
                        x:Name="MediaTimelineRow"
                        Grid.Row="1"
                        Height="{StaticResource SeekHitTargetHeight}"
                        Margin="0,8,0,0"
                        VerticalAlignment="Center"
                        ColumnSpacing="{StaticResource Spacing8}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="MediaElapsedText"
                            Grid.Column="0"
                            Text="0:00"
                            FontFamily="{StaticResource NotchFontFamily}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="Normal"
                            Foreground="{StaticResource NotchSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextLineBounds="Tight"
                            OpticalMarginAlignment="TrimSideBearings"
                            Typography.NumeralAlignment="Tabular"
                            IsHitTestVisible="False" />

                        <Grid
                            x:Name="SeekInteractiveSurface"
                            Grid.Column="1"
                            Height="{StaticResource SeekHitTargetHeight}"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="Seek position"
                            PointerEntered="OnSeekSurfacePointerEntered"
                            PointerExited="OnSeekSurfacePointerExited"
                            PointerPressed="OnSeekSurfacePointerPressed"
                            PointerMoved="OnSeekSurfacePointerMoved"
                            PointerReleased="OnSeekSurfacePointerReleased"
                            PointerCanceled="OnSeekSurfacePointerCanceled"
                            PointerCaptureLost="OnSeekSurfacePointerCaptureLost">

                            <!-- Subtle Inactive Track -->
                            <Border
                                x:Name="SeekTrackBackground"
                                Height="{StaticResource SeekTrackHeight}"
                                CornerRadius="{StaticResource RadiusSeekTrack}"
                                Background="{StaticResource NotchSecondaryBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                IsHitTestVisible="False" />

                            <!-- Active Progress Bar (clipped on the Compositor thread) -->
                            <Border
                                x:Name="SeekTrackFill"
                                Height="{StaticResource SeekTrackHeight}"
                                CornerRadius="{StaticResource RadiusSeekTrack}"
                                Background="{StaticResource NotchPrimaryBrush}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                IsHitTestVisible="False" />

                            <!-- Small Circular Thumb (translated on the Compositor thread) -->
                            <Canvas
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False">
                                <Border
                                    x:Name="SeekThumb"
                                    Width="{StaticResource SeekThumbSize}"
                                    Height="{StaticResource SeekThumbSize}"
                                    CornerRadius="{StaticResource RadiusSeekThumb}"
                                    Background="{StaticResource NotchPrimaryBrush}"
                                    Canvas.Left="-4"
                                    Canvas.Top="-4" />
                            </Canvas>
                        </Grid>

                        <TextBlock
                            x:Name="MediaDurationText"
                            Grid.Column="2"
                            Text="0:00"
                            FontFamily="{StaticResource NotchFontFamily}"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="Normal"
                            Foreground="{StaticResource NotchSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextLineBounds="Tight"
                            OpticalMarginAlignment="TrimSideBearings"
                            Typography.NumeralAlignment="Tabular"
                            IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <!-- 4c. Clipboard Hover Preview (220x44: [28x28 Icon or Image Preview] + [Single-Line Preview Text] + [Screenshot Action]) -->
                <Grid
                    x:Name="ClipboardHoverViewHost"
                    Width="{StaticResource NotchHoverWidth}"
                    Height="{StaticResource NotchHoverHeight}"
                    Padding="{StaticResource ClipboardHoverPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnSpacing="{StaticResource Spacing8}"
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Rounded 28x28 Clipboard Preview Badge (Icon or Image Thumbnail) -->
                    <Border
                        x:Name="ClipboardPreviewBadgeHost"
                        Grid.Column="0"
                        Width="{StaticResource ClipboardHoverPreviewSize}"
                        Height="{StaticResource ClipboardHoverPreviewSize}"
                        CornerRadius="{StaticResource Radius8}"
                        Background="{StaticResource NotchElevatedBrush}"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <Grid>
                            <!-- Vector Clipboard Icon (for Text / Unsupported) -->
                            <Path
                                x:Name="ClipboardTextBadgeIcon"
                                Width="{StaticResource ClipboardHoverIconSize}"
                                Height="{StaticResource ClipboardHoverIconSize}"
                                Stretch="Uniform"
                                Fill="{StaticResource NotchSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 3.5,1 L 6.5,1 L 6.5,2.2 L 8.2,2.2 L 8.2,9.2 L 1.8,9.2 L 1.8,2.2 L 3.5,2.2 Z M 3,3.4 L 3,8 L 7,8 L 7,3.4 Z" />

                            <!-- Vector Image Icon Fallback (when ClipboardContentType.Image has no decoded thumbnail) -->
                            <Path
                                x:Name="ClipboardImageFallbackIcon"
                                Width="{StaticResource ClipboardHoverIconSize}"
                                Height="{StaticResource ClipboardHoverIconSize}"
                                Stretch="Uniform"
                                Fill="{StaticResource NotchSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Data="M 1.2,2 L 8.8,2 L 8.8,8 L 1.2,8 Z M 2.2,6.8 L 4,4.6 L 5.4,6.1 L 6.6,4.9 L 7.8,6.8 Z" />

                            <!-- Rounded Image Thumbnail Preview -->
                            <Border
                                x:Name="ClipboardImagePreviewClip"
                                CornerRadius="{StaticResource Radius8}"
                                Visibility="Collapsed">
                                <Image
                                    x:Name="ClipboardPreviewImage"
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Single-Line Trimmed Clipboard Preview Text -->
                    <TextBlock
                        x:Name="ClipboardPreviewText"
                        Grid.Column="1"
                        FontFamily="{StaticResource NotchFontFamily}"
                        FontSize="{StaticResource FontSizeSecondary}"
                        FontWeight="Medium"
                        Foreground="{StaticResource NotchPrimaryBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1"
                        TextLineBounds="Tight" />

                    <!-- Subtle Screenshot Action Button in Clipboard Hover -->
                    <Button
                        x:Name="ClipboardScreenshotButton"
                        Grid.Column="2"
                        Style="{StaticResource NotchMediaTransportButtonStyle}"
                        AutomationProperties.Name="Capture screenshot"
                        VerticalAlignment="Center"
                        Click="OnScreenshotCaptureButtonClick"
                        PointerEntered="OnTransportButtonPointerEntered"
                        PointerExited="OnTransportButtonPointerExited"
                        PointerCanceled="OnTransportButtonPointerCanceled"
                        PointerCaptureLost="OnTransportButtonPointerCaptureLost">
                        <Grid
                            Width="{StaticResource MediaControlButtonSize}"
                            Height="{StaticResource MediaControlButtonSize}">
                            <Border
                                x:Name="ClipboardScreenshotButtonBg"
                                CornerRadius="{StaticResource Radius8}"
                                Background="{StaticResource NotchElevatedBrush}" />
                            <Path
                                x:Name="ClipboardScreenshotButtonIcon"
                                Width="{StaticResource ScreenshotActionIconSize}"
                                Height="{StaticResource ScreenshotActionIconSize}"
                                Stretch="Uniform"
                                Fill="{StaticResource NotchPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="F0 M 3.4,1.5 L 4.1,0.7 L 5.9,0.7 L 6.6,1.5 L 8.5,1.5 C 9.05,1.5 9.5,1.95 9.5,2.5 L 9.5,7.5 C 9.5,8.05 9.05,8.5 8.5,8.5 L 1.5,8.5 C 0.95,8.5 0.5,8.05 0.5,7.5 L 0.5,2.5 C 0.5,1.95 0.95,1.5 1.5,1.5 Z M 5,3.1 C 3.84,3.1 2.9,4.04 2.9,5.2 C 2.9,6.36 3.84,7.3 5,7.3 C 6.16,7.3 7.1,6.36 7.1,5.2 C 7.1,4.04 6.16,3.1 5,3.1 Z" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- 4d. Screenshot Hover Preview (220x44: [Aspect-Ratio Thumbnail] + [Screenshot + Dimensions] + [Recapture Action]) -->
                <Grid
                    x:Name="ScreenshotPreviewViewHost"
                    Width="{StaticResource NotchHoverWidth}"
                    Height="{StaticResource NotchHoverHeight}"
                    Padding="{StaticResource ScreenshotHoverPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnSpacing="{StaticResource Spacing8}"
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Rounded Compact Screenshot Thumbnail (max 44x28 preserving aspect ratio) -->
                    <Border
                        x:Name="ScreenshotThumbnailHost"
                        Grid.Column="0"
