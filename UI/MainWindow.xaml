<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsNotch.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Notch">

    <Grid Background="{StaticResource NotchBackgroundBrush}">
        <Border
            Background="{StaticResource NotchSurfaceBrush}"
            CornerRadius="{StaticResource Radius16}"
            Padding="{StaticResource Padding24}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Spacing="{StaticResource Spacing8}">
                <TextBlock
                    Text="Windows Notch"
                    FontFamily="{StaticResource NotchFontFamily}"
                    FontSize="{StaticResource FontSizeLarge}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryBrush}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Text="Foundation Ready"
                    FontFamily="{StaticResource NotchFontFamily}"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource NotchSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
