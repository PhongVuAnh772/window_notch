<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography (.antigravity/design.md) -->
    <FontFamily x:Key="NotchFontFamily">Segoe UI Variable</FontFamily>

    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeSecondary">12</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeTitle">14</x:Double>
    <x:Double x:Key="FontSizeLarge">20</x:Double>
    <x:Double x:Key="FontSizeHero">24</x:Double>

    <!-- Colors (.antigravity/design.md) -->
    <Color x:Key="NotchBackgroundColor">#FF0D0D0F</Color>
    <Color x:Key="NotchSurfaceColor">#FF171719</Color>
    <Color x:Key="NotchElevatedColor">#FF222225</Color>
    <Color x:Key="NotchPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="NotchSecondaryColor">#FFA1A1AA</Color>
    <Color x:Key="NotchTertiaryColor">#FF71717A</Color>
    <Color x:Key="NotchAccentColor">#FF8B8BFF</Color>

    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="{StaticResource NotchBackgroundColor}" />
    <SolidColorBrush x:Key="NotchSurfaceBrush" Color="{StaticResource NotchSurfaceColor}" />
    <SolidColorBrush x:Key="NotchElevatedBrush" Color="{StaticResource NotchElevatedColor}" />
    <SolidColorBrush x:Key="NotchPrimaryBrush" Color="{StaticResource NotchPrimaryColor}" />
    <SolidColorBrush x:Key="NotchSecondaryBrush" Color="{StaticResource NotchSecondaryColor}" />
    <SolidColorBrush x:Key="NotchTertiaryBrush" Color="{StaticResource NotchTertiaryColor}" />
    <SolidColorBrush x:Key="NotchAccentBrush" Color="{StaticResource NotchAccentColor}" />
    <SolidColorBrush x:Key="ScreenshotHistoryThumbnailBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ScreenshotHistoryThumbnailSelectedBorderBrush" Color="{StaticResource NotchAccentColor}" />

    <!-- Subtle Surface & Inner Depth Brushes (.antigravity/design.md) -->
    <LinearGradientBrush x:Key="NotchSurfaceGlassBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource NotchBackgroundColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource NotchSurfaceColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NotchInnerDepthBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#000D0D0F" Offset="0.35" />
        <GradientStop Color="{StaticResource NotchElevatedColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Spacing (.antigravity/design.md) -->
    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing6">6</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing20">20</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>

    <Thickness x:Key="Padding24">24</Thickness>
    <Thickness x:Key="MediaHoverPadding">12,0,8,0</Thickness>
    <Thickness x:Key="MediaExpandedPadding">16,12,16,12</Thickness>
    <Thickness x:Key="ClipboardHoverPadding">12,0,8,0</Thickness>
    <Thickness x:Key="ScreenshotHoverPadding">12,0,8,0</Thickness>
    <Thickness x:Key="ScreenshotHistoryPadding">16,10,16,10</Thickness>
    <Thickness x:Key="CalendarHoverPadding">12,0,12,0</Thickness>
    <Thickness x:Key="ClockHoverPadding">16,0,8,0</Thickness>
    <Thickness x:Key="DropTargetPadding">16,12,16,12</Thickness>

    <!-- Radius (.antigravity/design.md) -->
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>
    <CornerRadius x:Key="Radius16">16</CornerRadius>
    <CornerRadius x:Key="Radius20">20</CornerRadius>
    <CornerRadius x:Key="Radius24">24</CornerRadius>
    <CornerRadius x:Key="RadiusCollapsedPill">15</CornerRadius>
    <CornerRadius x:Key="RadiusHoverPill">22</CornerRadius>
    <CornerRadius x:Key="RadiusScreenshotHistoryThumbnail">8</CornerRadius>
    <CornerRadius x:Key="RadiusSeekTrack">1.5</CornerRadius>
    <CornerRadius x:Key="RadiusSeekThumb">4</CornerRadius>

    <!-- Media Preview, Expanded, Clipboard, Screenshot, DragDrop, Calendar & Playback Controls (.antigravity/design.md) -->
    <x:Double x:Key="MediaHoverArtworkSize">28</x:Double>
    <x:Double x:Key="MediaExpandedArtworkSize">40</x:Double>
    <x:Double x:Key="ClipboardHoverPreviewSize">28</x:Double>
    <x:Double x:Key="ClipboardCollapsedIconSize">11</x:Double>
    <x:Double x:Key="ClipboardHoverIconSize">12</x:Double>
    <x:Double x:Key="ScreenshotHoverThumbnailMaxWidth">44</x:Double>
    <x:Double x:Key="ScreenshotHoverThumbnailHeight">28</x:Double>
    <x:Double x:Key="ScreenshotCollapsedIconSize">11</x:Double>
    <x:Double x:Key="ScreenshotActionIconSize">12</x:Double>
    <x:Double x:Key="ScreenshotHistoryThumbnailWidth">104</x:Double>
    <x:Double x:Key="ScreenshotHistoryThumbnailHeight">54</x:Double>
    <x:Double x:Key="ScreenshotHistoryGap">12</x:Double>
    <x:Double x:Key="ScreenshotHistoryMetadataSpacing">4</x:Double>
    <x:Double x:Key="DropTargetBadgeSize">32</x:Double>
    <x:Double x:Key="DropTargetIconSize">14</x:Double>
    <x:Double x:Key="DropCollapsedIconSize">11</x:Double>
    <x:Double x:Key="CalendarHoverIconSize">24</x:Double>
    <x:Double x:Key="CalendarHoverGlyphSize">12</x:Double>
    <x:Double x:Key="CalendarCollapsedIconSize">11</x:Double>
    <x:Double x:Key="MediaControlButtonSize">24</x:Double>
    <x:Double x:Key="MediaControlButtonSpacing">2</x:Double>
    <x:Double x:Key="MediaControlIconSize">10</x:Double>
    <x:Double x:Key="MediaMetadataStackSpacing">2</x:Double>
    <x:Double x:Key="SeekTrackHeight">3</x:Double>
    <x:Double x:Key="SeekThumbSize">8</x:Double>
    <x:Double x:Key="SeekHitTargetHeight">16</x:Double>

    <!-- Minimal Composition-driven media transport button style (no XAML storyboards or default chrome) -->
    <Style x:Key="NotchMediaTransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="Height" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal Composition-driven screenshot history thumbnail button style -->
    <Style x:Key="NotchHistoryThumbnailButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Notch Sizes (.antigravity/design.md) -->
    <x:Double x:Key="NotchCollapsedWidth">140</x:Double>
    <x:Double x:Key="NotchCollapsedHeight">30</x:Double>
    <x:Double x:Key="NotchHoverWidth">220</x:Double>
    <x:Double x:Key="NotchHoverHeight">44</x:Double>
    <x:Double x:Key="NotchDropTargetWidth">300</x:Double>
    <x:Double x:Key="NotchDropTargetHeight">64</x:Double>
    <x:Double x:Key="NotchMediumWidth">320</x:Double>
    <x:Double x:Key="NotchMediumHeight">120</x:Double>
    <x:Double x:Key="NotchMediaExpandedWidth">380</x:Double>
    <x:Double x:Key="NotchMediaExpandedHeight">88</x:Double>
    <x:Double x:Key="NotchScreenshotHistoryWidth">380</x:Double>
    <x:Double x:Key="NotchScreenshotHistoryHeight">120</x:Double>
    <x:Double x:Key="NotchExpandedWidth">420</x:Double>
    <x:Double x:Key="NotchExpandedHeight">260</x:Double>
    <x:Double x:Key="NotchHostCanvasWidth">452</x:Double>
    <x:Double x:Key="NotchHostCanvasHeight">172</x:Double>

</ResourceDictionary>
